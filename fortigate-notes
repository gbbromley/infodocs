
Using VCI mapping to hand over ZTP files on a device basis

VCI 221 - Arista;DCS-7010T-48;12.02;JPE17104573
VCI 220 - Arista;DCS-7010T-48;12.03;JPE18485124


config system dhcp server
    edit 3
        set dns-service default
        set default-gateway 192.168.1.1
        set netmask 255.255.255.0
        set interface "lan"
        config ip-range
            edit 1
                set start-ip 192.168.1.100
                set end-ip 192.168.1.199
            next
        end
        config options
            edit 1
                set code 67
                set type string
                set value "tftp://192.168.1.49/ios-bootstrap"
            next
            edit 2
                set code 67
                set type string
                set vci-match enable
                set vci-string "Arista;DCS-7010T-48;12.03;JPE18485124"
                set value "tftp://192.168.1.49/ztp-bootstrap"
            next
            edit 3
                set code 67
                set type string
                set vci-match enable
                set vci-string "Arista;DCS-7010T-48;12.02;JPE17104573"
                set value "tftp://192.168.1.49/ztp-bootstrap"
            next
        end
        config reserved-address
            edit 2
                set ip 192.168.1.220
                set mac 98:5d:82:86:c3:9e
            next
            edit 3
                set ip 192.168.1.221
                set mac 28:99:3a:66:f4:5a
            next
        end
    next
end


